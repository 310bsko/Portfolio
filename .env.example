# Copier ce fichier vers `.env` pour travailler en local. Ne jamais versionner `.env`.

DEBUG=True
SECRET_KEY=cle-locale-a-changer

# Adresse de l'administration (à garder secrète en ligne), par exemple mon-espace-prive/
ADMIN_URL=gestion/

# Hôtes autorisés, séparés par des virgules (*.vercel.app est déjà accepté)
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données : vide = fichier SQLite local. En ligne : adresse « pooled » de Neon.
# DATABASE_URL=postgres://utilisateur:motdepasse@hote-pooler.neon.tech/base?sslmode=require

# Médias : vide = dossier local media/. En ligne : cloudinary://CLE:SECRET@NOM_DU_CLOUD
# CLOUDINARY_URL=

# Emails : vide = affichés dans la console. Avec Resend :
# EMAIL_HOST=smtp.resend.com
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=cle-api-resend
# DEFAULT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
